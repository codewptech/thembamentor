// Production and Previews Base have full Workers observability enabled.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thembamentor",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1,
      "redact_query_string": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "issues": {
      "enabled": true
    }
  },
  "preview_urls": true,
  "previews": {
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true,
        "head_sampling_rate": 1,
        "redact_query_string": true
      },
      "traces": {
        "enabled": true,
        "persist": true,
        "head_sampling_rate": 1
      },
      "issues": {
        "enabled": true
      }
    }
  }
}
